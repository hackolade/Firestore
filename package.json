{
    "name": "Firestore",
    "version": "0.2.5",
    "author": "hackolade",
    "engines": {
        "hackolade": "1.12.x",
        "hackoladePlugin": "1.0.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "FIRESTORE",
            "title": "Cloud Firestore",
            "versions": []
        },
        "features": {
            "jaySchemaHasRequiredPatternField": true,
            "nestedCollections": true,
            "enableReverseEngineering": {
                "jsonDocument": true,
                "jsonSchema": true,
                "ddl": true,
                "xsd": true,
                "plugin": false
            },
            "restrictNestedFieldsAsPrimaryKey": false
        }
    },
    "description": "Hackolade plugin for Google Cloud Firestore",
    "disabled": false,
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged --config lint-staged.config.js",
        "pre-push": "npm run lint"
    },
    "scripts": {
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "lint:check": "oxlint --type-aware --type-check . || true",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "esbuild": "0.28.1",
        "esbuild-node-externals": "1.23.1",
        "esbuild-plugin-clean": "1.0.1",
        "lint-staged": "17.0.7",
        "oxlint": "1.70.0",
        "oxlint-tsgolint": "0.23.0",
        "prettier": "3.8.4",
        "simple-git-hooks": "2.13.1"
    },
    "overrides": {
        "minimatch": "10.2.4"
    }
}
